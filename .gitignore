# Keys and per-PC settings: never committed (the repository is public)
.env
.env.*
!.env.example

# Console logs (kept on each PC for 30 days)
logs/

# Test material: real customer slips, Betty screenshots with wager numbers and payments, evaluation results
scratch/
handwriting_examples/

